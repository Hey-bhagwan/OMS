# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/koaliving_oms?schema=public"

# Session & Security
SESSION_SECRET="koa-living-production-super-secret-key-32-chars-min"
APP_TIMEZONE="Asia/Kolkata"

# Uniware Integration
UNIWARE_BASE_URL="https://koaliving.unicommerce.com"
# Option A: Paste Bearer Token from Postman directly
UNIWARE_AUTH_TOKEN=""
# Option B: Or provide live OAuth credentials (username & password)
UNIWARE_USERNAME="api_user"
UNIWARE_PASSWORD="api_password"
UNIWARE_CLIENT_ID="my-trusted-client"
UNIWARE_SYNC_INTERVAL_SECONDS="300"
UNIWARE_INITIAL_LOOKBACK_DAYS="60"
UNIWARE_FROM_DATE="2026-10-01T00:00:00"
UNIWARE_PAGE_SIZE="50"

# Shiprocket Integration
SHIPROCKET_WEBHOOK_SECRET="sr_webhook_secret_key"
SHIPROCKET_CARGO_WEBHOOK_SECRET="sr_cargo_webhook_secret_key"
